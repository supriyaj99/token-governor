# -------------------------------------------------------------------
# .env.example  — copy this file to ".env" and edit as needed.
#
# A .env file holds settings/secrets OUTSIDE your code. The app reads it on
# startup. NEVER commit your real ".env" to Git (the .gitignore already blocks
# it) — it may hold API keys later.
# -------------------------------------------------------------------

# Mock mode: "true" = free fake responses, no API key needed (use this to start).
# Set to "false" only when you're ready to call real paid models.
MOCK_MODE=true

# Which database to use.
# - For docker-compose (recommended), leave this as the Postgres line below.
# - For a quick local run WITHOUT Docker, comment that out and use the SQLite line.
DATABASE_URL=postgresql+psycopg2://tokengov:tokengov@db:5432/tokengov
# DATABASE_URL=sqlite:///./tokengov.db

# The port the gateway listens on.
APP_PORT=8000

# ---- Only needed later, when MOCK_MODE=false ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
